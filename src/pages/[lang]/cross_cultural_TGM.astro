---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allSurveys = await getCollection("participate");

  const survey = allSurveys.find((s) =>
    s.id.toLowerCase().includes("cross-cultural-tgm"),
  );

  if (!survey) {
    throw new Error("Cross-cultural TGM survey not found");
  }

  return [
    {
      params: { lang: "en" },
      props: { survey, lang: "en" },
    },
  ];
}

const { survey, lang } = Astro.props;

const pageTitle = survey.data.title;
const pageDescription = "Hidden page on cross-cultural TGM";
---

<Layout
  title={pageTitle}
  lang={lang}
  description={pageDescription}
  showNavbar={false}
  showNewsbar={false}
>
  <div class="fixed inset-0 flex items-center justify-center p-4 md:p-8">
    <div class="w-full max-w-2xl">
      <div class="bg-base-300 shadow-lg p-6 md:p-10 rounded-2xl max-h-[90vh] overflow-auto">
        <div class="flex flex-col text-center space-y-5">
          <div class="text-2xl md:text-4xl font-serif">
            {survey.data.title}
          </div>
          {
            survey.data.catchphrase && (
              <p class="text-base md:text-lg">{survey.data.catchphrase}</p>
            )
          }
          <p class="text-base md:text-lg">{survey.data.description}</p>
          {
            survey.data.subtitle && (
              <p class="text-lg md:text-xl font-bold text-primary">
                {survey.data.subtitle}
              </p>
            )
          }
          <div class="flex flex-wrap gap-3 justify-center pt-2">
            {
              survey.data.buttons.map((button) => (
                <a
                  href={button.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-soft btn-primary btn-lg"
                >
                  {button.text}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
