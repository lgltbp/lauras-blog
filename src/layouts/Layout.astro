---
import "@/styles/global.css";
import { Font } from "astro:assets";
import Newsbar from "@/components/Newsbar.astro";
import Navbar from "@/components/Navbar.astro";

interface Props {
  title?: string;
  lang: string;
  description?: string;
  showNewsbar?: boolean;
  showNavbar?: boolean;
}

const {
  title = "Laura's Blog",
  lang,
  description,
  showNewsbar = true,
  showNavbar = true,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link href="/favicon.png" rel="icon" type="image/png" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
    <meta content={Astro.generator} name="generator" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="bg-base-200 min-h-screen flex flex-col items-center">
    {showNewsbar && <Newsbar lang={lang} />}
    {showNavbar && <Navbar lang={lang} />}
    <main class="w-full flex flex-col pb-8">
      <slot />
    </main>
  </body>
</html>
